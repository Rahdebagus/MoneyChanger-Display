# ─── PAM Rate Board — configuration template ──────────────────────────────────
# Copy to .env and fill in. Never commit the real .env.
# Generate a secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- General ---------------------------------------------------------------
ENVIRONMENT=development          # development | production
DEBUG=false

# --- Database --------------------------------------------------------------
# The local XAMPP service is MariaDB 10.4, which speaks the MySQL protocol.
# PyMySQL is the driver. Create the database first:
#   CREATE DATABASE pam_rate_board CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DATABASE_URL=mysql+pymysql://pam_user:CHANGE_ME@127.0.0.1:3306/pam_rate_board?charset=utf8mb4
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- Security --------------------------------------------------------------
# Required in production; the app refuses to start without it there.
SECRET_KEY=
ACCESS_TOKEN_TTL_MINUTES=720
BCRYPT_ROUNDS=12

LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
PAIRING_RATE_LIMIT_ATTEMPTS=20
PAIRING_RATE_LIMIT_WINDOW_SECONDS=300

# --- CORS ------------------------------------------------------------------
# Specific origins only. A wildcard is rejected by browsers when credentials
# are involved and is wrong for an internal tool.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Storage ---------------------------------------------------------------
# Left blank these resolve to <repo>/storage and <repo>/backend/assets.
# Point STORAGE_DIR at a durable volume in production.
STORAGE_DIR=
ASSETS_DIR=
PUBLIC_BASE_URL=http://localhost:8000

# --- Display / player ------------------------------------------------------
HEARTBEAT_INTERVAL_SECONDS=30
DISPLAY_OFFLINE_AFTER_SECONDS=90
PLAYER_POLL_INTERVAL_SECONDS=300
PAIRING_CODE_TTL_SECONDS=600

# --- Jobs / worker ---------------------------------------------------------
JOB_POLL_INTERVAL_SECONDS=2
JOB_MAX_ATTEMPTS=3
JOB_TIMEOUT_SECONDS=600
VIDEO_DURATION_SECONDS=600

# --- Events ----------------------------------------------------------------
EVENT_POLL_INTERVAL_SECONDS=2
EVENT_RETENTION_HOURS=24

# --- Compatibility ---------------------------------------------------------
# Keeps the pre-2.0 flat endpoints (/upload, /generate, ...) mounted.
# They now require authentication; see docs/architecture.md.
ENABLE_LEGACY_API=true

# --- Timezone --------------------------------------------------------------
DISPLAY_TIMEZONE=Asia/Makassar

# ─── Frontend (frontend/.env.local) ───────────────────────────────────────────
# VITE_API_BASE_URL=http://localhost:8000
# VITE_DISPLAY_TIMEZONE=Asia/Makassar
