# Copy to frontend/.env.local for development.
#
# Leave VITE_API_BASE_URL unset to have the app talk to the same hostname it
# was loaded from, on port 8000. That default is what lets a TV or a phone on
# the LAN reach the API without a rebuild; a hardcoded "localhost" would only
# ever work on the developer's own machine.
VITE_API_BASE_URL=https://puspasarirate.my.id/python-test

# Timezone used to render and schedule times in the admin UI.
VITE_DISPLAY_TIMEZONE=Asia/Makassar
